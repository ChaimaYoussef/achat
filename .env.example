# ==============================================================================
# Configuration d'environnement exemple - Projet Achat (DevSecOps)
# Ce fichier sert de modèle. NE PAS COMMITER DE VRAIS SECRETS DANS LE DÉPÔT.
# Copiez ce fichier sous le nom '.env' pour votre environnement local.
# ==============================================================================

# Configuration Base de données (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=achatdb
DB_USERNAME=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe_securise
DB_USE_SSL=false

# Configuration Nexus Repository
NEXUS_USER=votre_identifiant_nexus
NEXUS_PASSWORD=votre_mot_de_passe_nexus

# Configuration Sécurité & CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Configuration Profil Spring
SPRING_PROFILES_ACTIVE=dev

